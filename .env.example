# Copy this file to .env and fill in your details.
# The SEC requires an identifiable User-Agent for all EDGAR requests.
# Format: "Name email@domain.com"
SEC_USER_AGENT="YourName youremail@example.com"

# LLM first pass (--llm-first-pass) — any OpenAI-compatible chat completions API.
# LLM_API_KEY="sk-..."
# LLM_BASE_URL="https://api.openai.com/v1"        # or https://api.x.ai/v1 for Grok, etc.
# LLM_MODEL="gpt-4o-mini"
# LLM_PROVIDER="openai-compatible"                # optional, defaults to "openai-compatible"
